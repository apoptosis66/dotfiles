{
    "current_theme": "catppuccin-mocha",
    "templates": {
        "hypr": {
            "src": "hypr.j2",
            "out": "~/.config/hypr/theme.conf"
        },
        "hyprpaper": {
            "src": "hyprpaper.j2",
            "out": "~/.config/hypr/hyprpaper.conf"
        },
        "mako": {
            "src": "mako.j2",
            "out": "~/.config/mako/config"
        },
        "ghostty": {
            "src": "ghostty.j2",
            "out": "~/.config/ghostty/theme.conf"
        },
        "nvim": {
            "src": "nvim.j2",
            "out": "~/.config/nvim/theme.vim"
        },
        "btop": {
            "src": "btop.j2",
            "out": "~/.config/btop/themes/current.theme"
        },
        "control-panel": {
            "src": "control-panel.j2",
            "out": "~/.config/themes/control-panel.css"
        }
    }
}